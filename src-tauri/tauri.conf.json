{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gul",
  "version": "0.1.0",
  "identifier": "org.gul.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GUL — Gestor Universal de Linux",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gestor Universal de Linux",
    "longDescription": "Gestor de paquetes unificado para Linux (Pacman, AUR, APT, DNF, Flatpak y AppImage).",
    "category": "Utility"
  }
}
